# Copy to .env.local (never committed) and fill in from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# reCAPTCHA Enterprise site key (Google Cloud console > Security > reCAPTCHA).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Development only. Leave empty to have the SDK print a new debug token in the
# browser console, then register it in Firebase console > App Check > Apps > Manage debug tokens.
# Never commit a real token.
VITE_APPCHECK_DEBUG_TOKEN=
