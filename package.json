{
  "name": "reopen",
  "version": "0.0.0",
  "private": true,
  "description": "Drop in a folder from an old computer. Your files come back, readable, and nothing leaves your laptop.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "smoke": "vite --open /smoke/",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit -p tests/tsconfig.json && vitest run",
    "samples": "node tools/make-samples.mjs",
    "licenses": "node tools/check-licenses.mjs",
    "secret-scan": "node tools/secret-scan.mjs",
    "prepare": "node tools/install-hooks.mjs"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cfb": "1.2.2",
    "chardet": "2.2.0",
    "codepage": "1.15.0",
    "docx": "9.16.0",
    "encoding-japanese": "2.5.0",
    "fflate": "0.8.3",
    "firebase": "13.4.0",
    "jschardet": "4.1.0",
    "rtf.js": "3.0.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
